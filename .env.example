OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# JSON file listing external MCP servers for the local agent (see mcp-servers.example.json)
MCP_SERVERS_CONFIG=./mcp-servers.json
FM_BIN=/usr/bin/fm
OLLAMA_RESEARCH_MODEL=gemma4:e4b
# Local database for collected feed items
FEEDS_DB_URL=file:./feeds.db
# JSON file overriding the default feed sources (see feed-sources.example.json)
FEED_SOURCES_CONFIG=./feed-sources.json
