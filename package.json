{
  "name": "@rsbuild-example/tanstack-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild",
    "preview": "rsbuild preview",
    "start": "srvx --prod -s ../client dist/server/index.js",
    "mcp:stdio": "tsx --env-file-if-exists=.env src/mastra/mcp/stdio.ts",
    "typecheck": "tsc",
    "feeds:collect": "tsx --env-file-if-exists=.env src/mastra/feeds/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.54",
    "@libsql/client": "0.18.0",
    "@mastra/core": "^1.69.0",
    "@mastra/libsql": "^1.23.1",
    "@mastra/mcp": "^1.18.0",
    "@mastra/memory": "^1.31.0",
    "@mastra/tanstack-start": "^0.2.27",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.8",
    "mastra": "^1.31.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "srvx": "^0.11.16",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "solid-js": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
